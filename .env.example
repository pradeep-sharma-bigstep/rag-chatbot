# Copy to .env (never commit .env):  cp .env.example .env

# --- Self-check -----------------------------------------------------------
# Your trainee ID, given by your trainer. Stamped on self_check_report.json.
SELF_CHECK_KEY=trainee-your-name

# --- LLM (milestone 1) -----------------------------------------------------
# groq (installed) | anthropic -> uv add langchain-anthropic | openai -> uv add langchain-openai
# Models differ per Groq account: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b were available
# to our key (llama-3.3-70b-versatile was not). List yours: `uv run python -c "import app.config;
# from groq import Groq; print([m.id for m in Groq().models.list().data])"`
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LangSmith observability (milestone 2) ---------------------------------
# Create a key at https://smith.langchain.com -> Settings -> API Keys.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-chatbot-your-name
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Chunking (milestone 3) ------------------------------------------------
# Name of a strategy you registered in app/vectordb/chunking.py
CHUNKING_STRATEGY=fixed
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Embeddings (milestone 4) ----------------------------------------------
# Local fastembed model, no API key needed. Empty = BAAI/bge-small-en-v1.5 (384 dims, ~70 MB).
# Others: BAAI/bge-base-en-v1.5 (768 dims), sentence-transformers/all-MiniLM-L6-v2 (384 dims).
# Changing the model changes the vector size, so re-index your documents afterwards.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval (milestone 7) -----------------------------------------------
TOP_K=4
# Optional: drop matches scoring below this (0-1, cosine). Off by default. With the default bge-small model,
# relevant chunks score ~0.55-0.8 and small talk ~0.45-0.55, so ~0.6 hides sources for off-topic questions.
# RETRIEVAL_MIN_SCORE=0.6

# --- Data folders (optional; defaults are under ./data) ---------------------
# DATA_DIR=./data
# SESSIONS_DIR=./data/sessions
# DOCUMENTS_DIR=./data/documents
# VECTOR_DIR=./data/vectorstore
